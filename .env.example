# Conta do piloto (api/pilot.ts). Na Vercel, defina em Settings > Environment Variables; em casa, copie para
# .env.local e rode com `vercel dev` (o `npm run dev` não executa a pasta api/, e o jogo segue só com progresso local).

# Chave que assina o cookie de sessão (HMAC). Sem ela ninguém entra. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Redis (Upstash) onde ficam os pilotos. Ao conectar um banco ao projeto em Storage, a Vercel injeta estas duas.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
